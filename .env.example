PORT=3000
MONGO_URI=

# wacrm public API (dashboard → Settings → API keys)
WACRM_BASE_URL=https://wa.focasedu.online
WACRM_API_KEY=

# Signing secret for incoming wacrm webhooks (whsec_...).
# You get it exactly once when you register this server's URL:
#   node scripts/registerWebhook.js https://<public-url-of-this-server>/webhook
WACRM_WEBHOOK_SECRET=



# Razorpay (dashboard → Account & Settings → API keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=X
# Razorpay dashboard → Settings → Webhooks: add https://<public-url>/razorpay/webhook
# with the payment_link.paid event, and put the same secret you enter there here
RAZORPAY_WEBHOOK_SECRET=
# Admin dashboard (client/) sessions — create admins with scripts/createAdmin.js
JWT_SECRET=
JWT_EXPIRES_IN=

# Admin dashboard origins allowed to call /api (comma-separated)
CORS_ORIGINS=https://waorders.focasedu.online,http://waorders.focasedu.online
